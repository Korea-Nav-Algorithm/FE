VITE_USE_MOCK_API=false
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Mock이 필요한 로컬 개발에서만 true로 변경. production build에서는 true면 빌드 실패.
# Vite 개발 서버가 실제 Backend로 프록시할 때만 설정합니다.
VITE_DEV_API_TARGET=http://localhost:8080
# 비밀 API 키는 VITE_ 환경변수에 넣지 말고 Backend에서만 관리합니다. TMAP API Key는 필요하지 않습니다.
